[Unit]
Description=Health check
After=network-online.target nse-gap-picks.service nse-gap-record.service
# At boot, check after the catch-up jobs have refreshed the data, not before.

[Service]
Type=oneshot
WorkingDirectory=%h/trading-workspace
ExecStart=%h/trading-workspace/.venv/bin/python %h/trading-workspace/scripts/health_check.py --quiet
TimeoutStartSec=300
