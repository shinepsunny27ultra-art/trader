[Unit]
Description=Keep the laptop awake through the trading day until 1615 (mains power only; released if unplugged)

# On battery or unplugged the script exits 75 and systemd retries every minute, so the
# lock comes back when the laptop is plugged in again.
StartLimitIntervalSec=0

[Service]
Restart=on-failure
RestartSec=60
Type=simple
WorkingDirectory=%h/trading-workspace
ExecStart=%h/trading-workspace/.venv/bin/python %h/trading-workspace/scripts/keep_awake.py 1615 --trading-days
